/ {
	chosen {
		zephyr,code-partition = &boot_partition;
		zephyr,console = &uart00;
		zephyr,uart-mcumgr = &uart00;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
		};
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_1 {
			gpios = <&gpio2 9 0>;
			label = "RGB blue channel";
		};
	};

	aliases {
		mcuboot-led0 = &blue_led;
		mcuboot-button0 = &button0;
	};
};
&pinctrl {
	/omit-if-no-ref/ uart00_default: uart00_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 2)>, <NRF_PSEL(UART_RX, 2, 0)>, <NRF_PSEL(UART_RTS, 2, 5)>, <NRF_PSEL(UART_CTS, 2, 4)>;
		};
	};

	/omit-if-no-ref/ uart00_sleep: uart00_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 2)>, <NRF_PSEL(UART_RX, 2, 0)>, <NRF_PSEL(UART_RTS, 2, 5)>, <NRF_PSEL(UART_CTS, 2, 4)>;
			low-power-enable;
		};
	};
};
&uart00 { 
	status = "okay"; 
	current-speed = <115200>;
	pinctrl-0 = <&uart00_default>;
	pinctrl-1 = <&uart00_sleep>;
	pinctrl-names = "default", "sleep";
};

/delete-node/ &code_partition;
&cpuapp_rram {
	status = "okay";
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(64)>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 DT_SIZE_K(500)>;
		};
		slot1_partition: partition@8D000 {
			label = "image-1";
			reg = <0x8D000 DT_SIZE_K(500)>;
		};
	};
};
