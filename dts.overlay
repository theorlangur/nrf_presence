#include "partitions.dtsi"
#include "usb_uart.dtsi"
/ {
	chosen {
		ncs,zigbee-timer = &timer20;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart00;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
			label = "Blue LED 0";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Boot";
		};
		button1: button_1 {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Zigbee";
		};
	};

	aliases {
		userled0 = &led0;
		presence = &mmwave_sensor_1;
		presence2 = &mmwave_sensor_2;
		pir = &pir_sensor;
		mmwave-uart = &uart20;
		mmwave-uart2 = &uart22;
	};

	/* A standalone node describing your hardware */
	dfr_presence_sensor: presence_sensor {
		compatible = "gpio-keys";
		mmwave_sensor_1: mmwave_sensor_1{
			gpios = <&gpio1 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Presence Sensor";
		};
		mmwave_sensor_2: mmwave_sensor_2{
			gpios = <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Presence Sensor 2";
		};
		pir_sensor: pir_sensor{
			gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "PIR Sensor";
		};
	};
};

&pinctrl {
	//Presence 1 UART
	/omit-if-no-ref/ uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 9)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>, <NRF_PSEL(UART_RX, 1, 9)>;
			low-power-enable;
		};
	};

	//i2c sensor bus
	/omit-if-no-ref/ i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
		};
	};

	/omit-if-no-ref/ i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
			low-power-enable;
		};
	};

	//Presence 2 UART
	/omit-if-no-ref/ uart22_default: uart22_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 14)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 13)>;
			bias-pull-up;
		};
	};

	/omit-if-no-ref/ uart22_sleep: uart22_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 14)>, <NRF_PSEL(UART_RX, 1, 13)>;
			low-power-enable;
		};
	};
};


&timer20 {
	status = "okay";
};

&uart20 {
	status = "okay";
	/* current-speed = <9600>; */
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart22 {
	status = "okay";
	/* current-speed = <9600>; */
	current-speed = <115200>;
	pinctrl-0 = <&uart22_default>;
	pinctrl-1 = <&uart22_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	eco2sensor: ens160@53{
		compatible="sciosense,ens160";
		reg = <0x53>;
		status = "okay";
		//zephyr,deferred-init;
	};
	rht2sensor: aht21@38{
		compatible="aosong,dht20";
		reg = <0x38>;
		status = "okay";
		//zephyr,deferred-init;
	};
};

&gpio2 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};
